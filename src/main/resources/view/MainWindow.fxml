<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<fx:root type="AnchorPane" prefHeight="700.0" prefWidth="600.0"
         xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
    <children>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER"
                    AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="55.0"
                    AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">
            <content><VBox fx:id="messages" spacing="8.0" /></content>
        </ScrollPane>
        <TextField fx:id="input" onAction="#handleInput" prefHeight="40.0"
                   AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="85.0" AnchorPane.bottomAnchor="0.0" />
        <Button text="Send" onAction="#handleInput" prefHeight="40.0" prefWidth="80.0"
                AnchorPane.rightAnchor="0.0" AnchorPane.bottomAnchor="0.0" />
    </children>
</fx:root>
